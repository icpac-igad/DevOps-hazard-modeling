# Rename to .env and fill in your credentials

# IMERG Configuration
imerg_username=your_username
imerg_password=your_password
data_path=./data/

# Google Cloud Storage
GCS_BUCKET_NAME=your_bucket_name
GOOGLE_APPLICATION_CREDENTIALS=credentials/gcs-key.json

# TIPG (OGC API - Features) — river network source for download_river_network.py
# Cloud Run + Cloud SQL tipg
TIPG_API_BASE=https://eafw-tipg-599944230090.europe-west1.run.app
TIPG_RIVER_COLLECTION=gha.geoglows_rivers
